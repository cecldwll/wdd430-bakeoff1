# Supabase API Configuration (from https://supabase.com/dashboard)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - KEEP SECRET! Only use on server-side
# NEVER commit this file if it contains real keys
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Configuration
SUPABASE_STORAGE_BUCKET=images

# Optional: Database Connection for Admin Tasks
SUPABASE_DB_HOST=your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password
